# Lumen's settings. On the server they live in his service's environment file (0640, never
# committed); this file only names them.

# His Discord token, and the Anthropic API key of his AI layer (ai.py) when it's installed.
DISCORD_TOKEN=
ANTHROPIC_API_KEY=

# The owner's Discord id: the only person Lumen answers and DMs. He will not start without it.
LUMEN_OWNER_ID=

# Lunara's API and live feed. When unset, config.yaml's lunara: values are used.
LUNARA_API_URL=
LUNARA_WS_URL=

# Fleet overwatch: where his heartbeat goes. No heartbeat when the URL is unset.
ATLAS_HEARTBEAT_URL=
ATLAS_HEARTBEAT_SECRET=

# His health endpoint's address (127.0.0.1 and 8080 when unset).
HEALTH_HOST=
PORT=
